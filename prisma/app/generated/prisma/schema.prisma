generator client {
  provider = "prisma-client-js"
  output   = "./app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  role     String  @default("CASHIER")
  orders   Order[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Decimal
  stock     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  total     Decimal
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id])
  name    String
  price   Decimal
  qty     Int
}
